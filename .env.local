# Copy to .env.local and configure a Supabase project.
VITE_SUPABASE_URL=https://abzoccjsqpglrxziquav.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_tVxZ4lio0_eKXUVtperQbQ_rpwwVLjv

# Optional: enables ElevenLabs reading audio; leave blank to use browser speech.
# VITE_ variables are included in the client bundle. Use a server-side proxy for production secrets.
VITE_ELEVENLABS_API_KEY=

# Server-only Gemini essay grader secret. Do NOT rename this to VITE_GEMINI_API_KEY.
# Local Vite development reads it on the Node server; Netlify production reads a site env var.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Override with a Turkish voice ID from your ElevenLabs workspace if desired.
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional seasonal feature flags. Enable the control to allow Winter Mode.
VITE_WINTER_UPDATE_ENABLED=false
# Set true to auto-enable Winter Mode during December–February.
VITE_WINTER_UPDATE_AUTO=false
